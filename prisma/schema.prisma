// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  showAvailability ShowAvailability[]
  unavailableDates MemberUnavailability[]
  createdShows     Show[]                 @relation("ShowCreator")
  createdSongs     Song[]                 @relation("SongCreator")
  createdReleases  Release[]              @relation("ReleaseCreator")
  songComments     SongComment[]
  bandMemberships  BandMembership[]
  sentInvites      BandInvite[]           @relation("InviteSender")
  accounts         Account[]
  sessions         Session[]
}

enum Role {
  ADMIN
  MEMBER
}

// A band or solo artist. Every show, song, and release belongs to exactly one.
model Band {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships BandMembership[]
  invites     BandInvite[]
  shows       Show[]
  songs       Song[]
  releases    Release[]
}

model BandInvite {
  id          String    @id @default(cuid())
  bandId      String
  email       String
  role        BandRole  @default(MEMBER)
  token       String    @unique
  invitedById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  band      Band @relation(fields: [bandId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InviteSender", fields: [invitedById], references: [id])

  @@unique([bandId, email])
  @@index([email])
}

model BandMembership {
  id        String   @id @default(cuid())
  bandId    String
  userId    String
  role      BandRole @default(MEMBER)
  createdAt DateTime @default(now())

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bandId, userId])
  @@index([userId])
}

enum BandRole {
  OWNER
  ADMIN
  MEMBER
}

model Show {
  id          String     @id @default(cuid())
  type        EventType  @default(SHOW)
  title       String
  venue       String?
  city        String?
  state       String?
  country     String     @default("US")
  date        DateTime
  doorsTime   DateTime?
  setTime     DateTime?
  loadInTime  DateTime?
  guarantee   Float?
  notes       String?
  venueAddress String?
  venueLat     Float?
  venueLng     Float?
  status      ShowStatus @default(PENDING)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy    User               @relation("ShowCreator", fields: [createdById], references: [id])
  availability ShowAvailability[]
  band         Band               @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId       String

  @@index([bandId])
}

enum EventType {
  SHOW
  RECORDING
}

enum ShowStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model ShowAvailability {
  id        String             @id @default(cuid())
  userId    String
  showId    String
  status    AvailabilityStatus @default(PENDING)
  note      String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([userId, showId])
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  PENDING
}

model MemberUnavailability {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Song {
  id          String     @id @default(cuid())
  title       String
  status      SongStatus @default(IDEA)
  key         String?
  tempo       Int?
  timeSig     String?
  lyrics      String?    @db.Text
  notes       String?    @db.Text
  samplyUrl   String?
  createdById String
  updatedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy User          @relation("SongCreator", fields: [createdById], references: [id])
  comments  SongComment[]
  tracks    ReleaseTrack[]
  band      Band          @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId    String

  @@index([status])
  @@index([bandId])
}

enum SongStatus {
  IDEA
  WRITING
  DEMO
  READY_TO_TRACK
  TRACKED
  RELEASED
}

model SongComment {
  id        String   @id @default(cuid())
  songId    String
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([songId])
}

model Release {
  id          String        @id @default(cuid())
  title       String
  kind        ReleaseKind   @default(ALBUM)
  status      ReleaseStatus @default(PLANNING)
  targetDate  DateTime?     @db.Date
  notes       String?       @db.Text
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy User           @relation("ReleaseCreator", fields: [createdById], references: [id])
  tracks    ReleaseTrack[]
  band      Band           @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId    String

  @@index([bandId])
}

enum ReleaseKind {
  ALBUM
  EP
  SINGLE
  GROUP
}

enum ReleaseStatus {
  PLANNING
  WRITING
  TRACKING
  MIXING
  RELEASED
}

model ReleaseTrack {
  id        String @id @default(cuid())
  releaseId String
  songId    String
  position  Int

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  song    Song    @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([releaseId, songId])
  @@index([releaseId])
}
