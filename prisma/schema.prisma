// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  showAvailability ShowAvailability[]
  unavailableDates MemberUnavailability[]
  createdShows     Show[]                 @relation("ShowCreator")
  createdSongs     Song[]                 @relation("SongCreator")
  editedSongs      Song[]                 @relation("SongEditor")
  createdReleases  Release[]              @relation("ReleaseCreator")
  createdPlans     RecordingPlan[]        @relation("RecordingPlanCreator")
  recordingParts   RecordingPart[]        @relation("RecordingPartAssignee")
  songComments     SongComment[]
  songDemos        SongDemo[]             @relation("SongDemoCreator")
  bandMemberships  BandMembership[]
  sentInvites      BandInvite[]           @relation("InviteSender")
  accounts         Account[]
  sessions         Session[]
  pushSubscriptions PushSubscription[]
}

enum Role {
  ADMIN
  MEMBER
}

// A band or solo artist. Every show, song, and release belongs to exactly one.
model Band {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships BandMembership[]
  invites     BandInvite[]
  shows       Show[]
  songs       Song[]
  releases    Release[]
  instruments Instrument[]
}

model BandInvite {
  id          String    @id @default(cuid())
  bandId      String
  email       String
  role        BandRole  @default(MEMBER)
  token       String    @unique
  invitedById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  band      Band @relation(fields: [bandId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InviteSender", fields: [invitedById], references: [id])

  @@unique([bandId, email])
  @@index([email])
}

model BandMembership {
  id        String   @id @default(cuid())
  bandId    String
  userId    String
  role      BandRole @default(MEMBER)
  createdAt DateTime @default(now())

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bandId, userId])
  @@index([userId])
}

enum BandRole {
  OWNER
  ADMIN
  MEMBER
}

model Show {
  id           String     @id @default(cuid())
  type         EventType  @default(SHOW)
  title        String
  venue        String?
  city         String?
  state        String?
  country      String     @default("US")
  date         DateTime
  doorsTime    DateTime?
  setTime      DateTime?
  loadInTime   DateTime?
  guarantee    Float?
  notes        String?
  venueAddress String?
  venueLat     Float?
  venueLng     Float?
  status       ShowStatus @default(PENDING)
  createdById  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Set when the event was created as one day of a multi-day tour / recording
  // block (POST /api/shows/bulk). Every day in that block shares the same
  // tourGroupId, and tourName is the block's label ("Fall Tour"), kept so the
  // block can be edited as a unit (PATCH /api/shows/bulk).
  tourGroupId  String?
  tourName     String?

  createdBy    User               @relation("ShowCreator", fields: [createdById], references: [id])
  availability ShowAvailability[]
  band         Band               @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId       String

  // Optional link from a RECORDING session to the release it's tracking for.
  // SetNull so deleting a release leaves its sessions on the calendar.
  release   Release? @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  releaseId String?

  @@index([bandId])
  @@index([releaseId])
  @@index([tourGroupId])
}

enum EventType {
  SHOW
  RECORDING
}

enum ShowStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model ShowAvailability {
  id        String             @id @default(cuid())
  userId    String
  showId    String
  status    AvailabilityStatus @default(PENDING)
  note      String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([userId, showId])
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  PENDING
}

model MemberUnavailability {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One Web Push subscription = one browser on one device that opted in. A member
// with a phone and a laptop has two rows. `endpoint` is the push service URL the
// server POSTs to; `p256dh`/`auth` are the client's encryption keys. Rows are
// pruned in src/lib/push.ts when the push service reports them gone (404/410).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Song {
  id          String     @id @default(cuid())
  title       String
  status      SongStatus @default(IDEA)
  key         String?
  tempo       Int?
  timeSig     String?
  lyrics      String?    @db.Text
  notes       String?    @db.Text
  /// Deprecated: superseded by the SongDemo list. Kept so existing links
  /// survive a `prisma db push`; remove once every band has been backfilled.
  samplyUrl   String?
  createdById String
  updatedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy      User            @relation("SongCreator", fields: [createdById], references: [id])
  updatedBy      User?           @relation("SongEditor", fields: [updatedById], references: [id])
  comments       SongComment[]
  demos          SongDemo[]
  sections       SongSection[]
  tracks         ReleaseTrack[]
  recordingParts RecordingPart[]
  band           Band            @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId         String

  @@index([status])
  @@index([bandId])
}

model SongDemo {
  id          String   @id @default(cuid())
  songId      String
  label       String?
  url         String
  createdById String
  createdAt   DateTime @default(now())

  song      Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdBy User @relation("SongDemoCreator", fields: [createdById], references: [id])

  @@index([songId])
}

// One block of a song's arrangement (Intro, Verse 1, Chorus…). Ordered by
// `position`; belongs to the song itself, so it's the same list whether you
// open it from the song page or the release tracking plan.
model SongSection {
  id        String   @id @default(cuid())
  songId    String
  name      String
  notes     String?  @db.Text
  lyrics    String?  @db.Text
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
}

enum SongStatus {
  IDEA
  WRITING
  DEMO
  READY_TO_TRACK
  TRACKED
  RELEASED
}

model SongComment {
  id        String   @id @default(cuid())
  songId    String
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([songId])
}

model Release {
  id          String        @id @default(cuid())
  title       String
  kind        ReleaseKind   @default(ALBUM)
  status      ReleaseStatus @default(PLANNING)
  targetDate  DateTime?     @db.Date
  notes       String?       @db.Text
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy    User           @relation("ReleaseCreator", fields: [createdById], references: [id])
  tracks       ReleaseTrack[]
  trackingPlan RecordingPlan?
  sessions     Show[]
  band         Band           @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId       String

  @@index([bandId])
}

enum ReleaseKind {
  ALBUM
  EP
  SINGLE
  GROUP
}

enum ReleaseStatus {
  PLANNING
  WRITING
  TRACKING
  MIXING
  RELEASED
}

model ReleaseTrack {
  id        String @id @default(cuid())
  releaseId String
  songId    String
  position  Int

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  song    Song    @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([releaseId, songId])
  @@index([releaseId])
}

// A band's reusable library of instruments / parts that can be tracked.
// Seeded with a default set the first time a tracking plan is opened; bands
// add their own from there.
model Instrument {
  id        String   @id @default(cuid())
  bandId    String
  name      String
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  band  Band            @relation(fields: [bandId], references: [id], onDelete: Cascade)
  parts RecordingPart[]

  @@unique([bandId, name])
  @@index([bandId])
}

// The tracking plan for one release. One per release, created on demand.
model RecordingPlan {
  id          String   @id @default(cuid())
  releaseId   String   @unique
  notes       String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  release   Release         @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  createdBy User            @relation("RecordingPlanCreator", fields: [createdById], references: [id])
  parts     RecordingPart[]
}

// One instrument to be tracked for one song within a plan.
model RecordingPart {
  id           String              @id @default(cuid())
  planId       String
  songId       String
  instrumentId String
  label        String?
  description  String?             @db.Text
  status       RecordingPartStatus @default(TODO)
  assigneeId   String?
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  plan       RecordingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  song       Song          @relation(fields: [songId], references: [id], onDelete: Cascade)
  instrument Instrument    @relation(fields: [instrumentId], references: [id])
  assignee   User?         @relation("RecordingPartAssignee", fields: [assigneeId], references: [id])

  @@index([planId])
  @@index([songId])
  @@index([instrumentId])
}

enum RecordingPartStatus {
  TODO
  TRACKING
  TRACKED
  NEEDS_REDO
}
